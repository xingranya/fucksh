* text=auto

# Android 上跑的脚本必须是 LF，否则 mksh 会报 syntax error
*.sh            text eol=lf
gradlew         text eol=lf
*.prop          text eol=lf
*.list          text eol=lf
*.md            text eol=lf
*.java          text eol=lf
*.gradle        text eol=lf
*.py            text eol=lf
*.bat           text eol=crlf
*.jar           binary
*.apk           binary
*.zip           binary
